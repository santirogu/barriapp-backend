# BarriApp backend — environment variables (copy to .env and adjust)

# Environment: local | test | staging | production
ENVIRONMENT=local
DEBUG=true

# API
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# MongoDB (local dev via docker-compose in F-3; Atlas URI in staging/prod)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=barriapp

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth / JWT (generate strong secrets per environment; never commit real values)
JWT_SECRET_KEY=change-me-in-a-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Commerce
DEFAULT_COMMISSION_RATE=0.10
PREMIUM_COMMISSION_RATE=0.05
SUBSCRIPTION_PRICE=30000

# Payments (Wompi)
WOMPI_PUBLIC_KEY=pub_test_change_me
WOMPI_EVENTS_SECRET=change-me-wompi-events-secret
PAYMENT_CURRENCY=COP

# Security headers / proxy (production)
ENABLE_HSTS=false            # set true when served over HTTPS
HSTS_MAX_AGE=63072000
# Consumed by uvicorn --proxy-headers: which upstream IPs are trusted for
# X-Forwarded-For/Proto. "*" is fine when only the platform proxy reaches the app.
FORWARDED_ALLOW_IPS=*

# Rate limiting (Redis fixed-window, per client IP)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
AI_CHAT_RATE_LIMIT=30
AI_CHAT_RATE_WINDOW=60

# AI assistant (phase 2). Without ANTHROPIC_API_KEY a deterministic fallback LLM is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TOP_K=3

# Observability (added in F-5)
SENTRY_DSN=
