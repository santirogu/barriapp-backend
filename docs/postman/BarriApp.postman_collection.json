        { "name": "Update config", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"default_commission_rate\": 0.12\n}" }, "url": { "raw": "{{base_url}}/admin/config", "host": ["{{base_url}}"], "path": ["admin", "config"] } } }
